{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "description": "Qualified GCC 16.1 C++26/modules toolchain. Production profile disables experimental Contracts and Reflection.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/gcc.cmake"
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC 16 Debug (production stability)",
      "description": "Default development build. Internal invariants fail closed without GCC experimental Contracts.",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENPROOF_BUILD_TESTS": "ON",
        "OPENPROOF_ENABLE_EXPERIMENTAL_CONTRACTS": "OFF"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC 16 Release (production stability)",
      "description": "Optimized production-stability build with experimental Contracts disabled.",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "OPENPROOF_BUILD_TESTS": "ON",
        "OPENPROOF_ENABLE_EXPERIMENTAL_CONTRACTS": "OFF"
      }
    },
    {
      "name": "gcc-observe",
      "displayName": "GCC 16 Debug (EXPERIMENTAL Contracts observe)",
      "description": "Compiler qualification only. Enables GCC experimental Contracts with observe semantics; not production-qualified.",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENPROOF_CONTRACT_SEMANTIC": "observe",
        "OPENPROOF_BUILD_TESTS": "ON",
        "OPENPROOF_ENABLE_EXPERIMENTAL_CONTRACTS": "ON"
      }
    },
    {
      "name": "gcc-asan",
      "displayName": "GCC 16 Debug (ASan + UBSan)",
      "description": "Hardening build with address and undefined-behavior sanitizers.",
      "inherits": "gcc-debug",
      "cacheVariables": {
        "OPENPROOF_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "gcc-fuzz",
      "displayName": "GCC 16 coverage-guided boundary fuzzing",
      "description": "ASan/UBSan plus GCC trace-pc feedback over security-critical parsers.",
      "inherits": "gcc-debug",
      "cacheVariables": {
        "OPENPROOF_BUILD_TESTS": "OFF",
        "OPENPROOF_BUILD_EXAMPLES": "OFF",
        "OPENPROOF_BUILD_COVERAGE_FUZZER": "ON",
        "OPENPROOF_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC 16 Debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "displayName": "GCC 16 Release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-observe",
      "displayName": "GCC 16 Debug (contracts: observe)",
      "configurePreset": "gcc-observe"
    },
    {
      "name": "gcc-asan",
      "displayName": "GCC 16 Debug (ASan + UBSan)",
      "configurePreset": "gcc-asan"
    },
    {
      "name": "gcc-fuzz",
      "displayName": "GCC 16 coverage-guided boundary fuzzer",
      "configurePreset": "gcc-fuzz",
      "targets": ["openproof_boundary_fuzzer"]
    }
  ],
  "testPresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC 16 Debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC 16 Release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-observe",
      "displayName": "GCC 16 Debug (contracts: observe)",
      "configurePreset": "gcc-observe",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-asan",
      "displayName": "GCC 16 Debug (ASan + UBSan)",
      "configurePreset": "gcc-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
