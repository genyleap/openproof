OPENPROOF_DELIVERY_TOKEN_FILE=/run/openproof/secrets/verification-webhook.token
OPENPROOF_DELIVERY_FROM=no-reply@identity.example.com
OPENPROOF_DELIVERY_BRAND=Example Identity
OPENPROOF_DELIVERY_SIGNUP_URL=https://identity.example.com/account?flow=verify-email
OPENPROOF_DELIVERY_CHANGE_EMAIL_URL=https://identity.example.com/account?flow=change-email
OPENPROOF_DELIVERY_PASSWORD_RESET_URL=https://identity.example.com/account?flow=reset-password
OPENPROOF_DELIVERY_SMTP_HOST=127.0.0.1
OPENPROOF_DELIVERY_SMTP_PORT=25
