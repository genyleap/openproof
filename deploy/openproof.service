[Unit]
Description=OpenProof identity and authorization service
Documentation=file:/opt/genyleap/openproof/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=openproof
Group=openproof
EnvironmentFile=/etc/openproof/openproof.env
EnvironmentFile=-/etc/openproof/providers.env
ExecStartPre=/usr/bin/test -r /etc/openproof/openproof.toml
ExecStartPre=/usr/bin/test -x /opt/genyleap/openproof/runtime/bin/opp
ExecStartPre=/opt/genyleap/openproof/runtime/bin/opp check-config --config /etc/openproof/openproof.toml
ExecStart=/opt/genyleap/openproof/runtime/bin/opp server --config /etc/openproof/openproof.toml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/run/openproof/secrets
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openproof

[Install]
WantedBy=multi-user.target
