# Optional environment-only feature credentials. The production TOML template
# reads the master key, database URL, delivery bearer and OIDC private key from
# /run/openproof/secrets so a secret-store/KMS agent can mount them without
# placing their values in the service environment. Never source or commit a
# populated copy of this file.

# Add only when the matching feature is enabled:
# OPENPROOF_SCIM_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# OPENPROOF_MTLS_FORWARDING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Redirect-based federation. The callback must exactly match the URL registered
# with every enabled upstream provider.
# OPENPROOF_FEDERATION_CALLBACK_URI=https://identity.example.com/auth/federated/callback
# OPENPROOF_FEDERATION_CA_FILE=/run/openproof/certs/federation-ca.pem
#
# Google OpenID Connect:
# OPENPROOF_GOOGLE_CLIENT_ID=REPLACE_ME
# OPENPROOF_GOOGLE_CLIENT_SECRET=REPLACE_ME
# OPENPROOF_GOOGLE_ISSUER=https://accounts.google.com
#
# GitHub OAuth:
# OPENPROOF_GITHUB_CLIENT_ID=REPLACE_ME
# OPENPROOF_GITHUB_CLIENT_SECRET=REPLACE_ME
#
# X (Twitter) OAuth 2.0 + PKCE:
# OPENPROOF_X_CLIENT_ID=REPLACE_ME
# OPENPROOF_X_CLIENT_SECRET=REPLACE_ME
#
# Sign in with Apple. Either provide a pre-generated client-secret JWT, or
# provide Team ID, Key ID, and the P-256 .p8 private-key file so OpenProof can
# generate a fresh short-lived client secret for each token exchange. OpenProof
# requests form_post authorization responses when name/email scopes are used.
# OPENPROOF_APPLE_CLIENT_ID=REPLACE_WITH_SERVICES_ID
# OPENPROOF_APPLE_CLIENT_SECRET=REPLACE_WITH_SIGNED_CLIENT_SECRET_JWT
# OPENPROOF_APPLE_TEAM_ID=REPLACE_WITH_10_CHARACTER_TEAM_ID
# OPENPROOF_APPLE_KEY_ID=REPLACE_WITH_10_CHARACTER_KEY_ID
# OPENPROOF_APPLE_PRIVATE_KEY_FILE=/run/openproof/secrets/AuthKey_REPLACE_ME.p8
# OPENPROOF_APPLE_ISSUER=https://appleid.apple.com
#
# Microsoft OpenID Connect. Use a tenant-specific v2 issuer; OpenProof rejects
# common/organizations/consumers authorities and issuer templates.
# OPENPROOF_MICROSOFT_CLIENT_ID=REPLACE_ME
# OPENPROOF_MICROSOFT_CLIENT_SECRET=REPLACE_ME
# OPENPROOF_MICROSOFT_ISSUER=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0
#
# LinkedIn OpenID Connect:
# OPENPROOF_LINKEDIN_CLIENT_ID=REPLACE_ME
# OPENPROOF_LINKEDIN_CLIENT_SECRET=REPLACE_ME
# OPENPROOF_LINKEDIN_ISSUER=https://www.linkedin.com/oauth
#
# Telegram OpenID Connect. Keep the BotFather ID-token algorithm at RS256 for
# the current OpenProof provider implementation.
# OPENPROOF_TELEGRAM_CLIENT_ID=REPLACE_ME
# OPENPROOF_TELEGRAM_CLIENT_SECRET=REPLACE_ME
# OPENPROOF_TELEGRAM_ISSUER=https://oauth.telegram.org

# Web3 relying-party binding (required when either Web3 adapter is enabled):
# OPENPROOF_WEB3_DOMAIN=login.example.com
# OPENPROOF_WEB3_URI=https://login.example.com/auth/web3
# OPENPROOF_WEB3_CA_FILE=/run/openproof/certs/web3-ca.pem

# EVM wallet / SIWE. EOAs can authenticate on any positive EVM chain without
# an RPC. Configure chain-specific RPCs only for ERC-1271/ERC-6492 smart wallets.
# OPENPROOF_ETHEREUM_WALLET_ENABLED=true
# OPENPROOF_ETHEREUM_RPC_ENDPOINTS=1=https://ethereum-rpc.example.com;8453=https://base-rpc.example.com;42161=https://arbitrum-rpc.example.com;5042=https://rpc.mainnet.arc.io;4663=https://rpc.mainnet.chain.robinhood.com
# OPENPROOF_ETHEREUM_RPC_AUTHORIZATION=Bearer REPLACE_ME
#
# Legacy single smart-wallet RPC mapping (still supported):
# OPENPROOF_ETHEREUM_RPC_ENDPOINT=https://ethereum-rpc.example.com
# OPENPROOF_ETHEREUM_CHAIN_ID=1

# Farcaster FIP-11 SIWF. Chain 10 and canonical IdRegistry/KeyRegistry addresses
# are defaults; registry overrides are mainly useful for controlled testing.
# OPENPROOF_FARCASTER_RPC_ENDPOINT=https://optimism-rpc.example.com
# OPENPROOF_FARCASTER_CHAIN_ID=10
# OPENPROOF_FARCASTER_ID_REGISTRY=0x00000000fc6c5f01fc30151999387bb99a9f489b
# OPENPROOF_FARCASTER_KEY_REGISTRY=0x00000000fc1237824fb747abde0ff18990e59b7e
# OPENPROOF_FARCASTER_RPC_AUTHORIZATION=Bearer REPLACE_ME
